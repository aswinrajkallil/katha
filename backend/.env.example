PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/katha
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Used for CORS and for the links in password reset emails (the first entry is used for links)
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email for password reset. In development, if these are unset the reset link is printed to the server
# console instead of being emailed. In production they are required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM="Kathā <no-reply@example.com>"

# Optional: database used ONLY by `npm test` (tests refuse to run against a database whose name does not contain "test")
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/katha_test
